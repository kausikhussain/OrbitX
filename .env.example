# ==============================================================================
# Orbit Watch — Environment Configuration Example
# ==============================================================================
#
# Orbit Watch is a pure static client application (no mandatory build step).
# By default, a demo NASA key is provided for testing.
# For production deployments with higher rate limits (up to 1,000 requests/hr),
# obtain a free key at https://api.nasa.gov/
#
# You can configure your key in client environments via any of the following:
#
# 1. Global script injection before app initialization:
#    <script>window.ORBIT_WATCH_API_KEY = "YOUR_NASA_API_KEY";</script>
#
# 2. Browser console or local storage:
#    localStorage.setItem("nasa_api_key", "YOUR_NASA_API_KEY");
#
# 3. Web server environment injection or proxy headers.

NASA_API_KEY=YOUR_NASA_API_KEY_HERE
PORT=4173

